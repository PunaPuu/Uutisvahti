# Copy to .env only for local experiments; .env is never committed.
# In GitHub, NTFY_TOPIC is an Actions secret (Settings > Secrets and variables > Actions).
# UV_SITE_URL: published site address (https). NTFY_SERVER defaults to https://ntfy.sh. UV_PORT defaults to 8080.
UV_SITE_URL=
NTFY_TOPIC=
NTFY_SERVER=
UV_PORT=
